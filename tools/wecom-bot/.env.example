WECHAT_BOT_ID=replace-with-bot-id
WECHAT_BOT_SECRET=replace-with-a-new-secret

# Comma-separated enterprise WeChat user IDs. Empty means nobody is allowed.
WECOM_ALLOWED_USER_IDS=

GROUNDMAP_CHAT_URL=http://localhost:3100/api/chat
GROUNDMAP_PROVIDER=claude-code
GROUNDMAP_MODEL=default
GROUNDMAP_WORKSPACE=accounting-standards
GROUNDMAP_MODE=quick
GROUNDMAP_TOOL_BUDGET=10
GROUNDMAP_QUERY_TIMEOUT_SECONDS=240

# Leave empty until GroundMap has an authenticated URL reachable by testers.
PUBLIC_KB_BASE_URL=

WECOM_DAILY_QUERY_LIMIT=10
WECOM_MAX_QUESTION_CHARS=2000
WECOM_HISTORY_DB=data/query-history.db
